{
  "$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/v1.4.json",
  "author": "Fluffyalien",
  "name": "bedrock_energistics",
  "packs": {
    "behaviorPack": "./packs/BP",
    "resourcePack": "./packs/RP"
  },
  "regolith": {
    "formatVersion": "1.4.0",
    "dataPath": "./packs/data",
    "filterDefinitions": {
      "build_scripts": {
        "runWith": "shell",
        "command": "npx esbuild BP/scripts/index.ts --outfile=BP/scripts/__bundle.js --bundle --format=esm --log-level=warning --external:@minecraft/common --external:@minecraft/debug-utilities --external:@minecraft/server --external:@minecraft/server-* --preserve-symlinks"
      },
      "prod_finish_up_build_scripts": {
        "runWith": "shell",
        "command": "npx terser BP/scripts/__bundle.js --module -cmo BP/scripts/__bundle.js; Remove-Item BP/scripts/* -Recurse -Exclude __bundle.js"
      },
      "simple_manifest": {
        "runWith": "nodejs",
        "script": "scripts/filters/simple_manifest.ts"
      },
      "machine_entities": {
        "runWith": "nodejs",
        "script": "scripts/filters/machine_entities.ts"
      },
      "tutorial_book_entries": {
        "runWith": "nodejs",
        "script": "scripts/filters/tutorial_book_entries.ts"
      },
      "ui_composite": {
        "runWith": "nodejs",
        "script": "scripts/filters/ui_composite.ts"
      }
    },
    "profiles": {
      "default": {
        "export": {
          "target": "development",
          "build": "standard"
        },
        "filters": [
          {
            "filter": "tutorial_book_entries"
          },
          {
            "filter": "build_scripts"
          },
          {
            "filter": "simple_manifest"
          },
          {
            "filter": "machine_entities"
          },
          {
            "filter": "ui_composite"
          }
        ]
      },
      "dev_localexport": {
        "export": {
          "target": "local"
        },
        "filters": [
          {
            "profile": "default"
          }
        ]
      },
      "prod": {
        "export": {
          "target": "local"
        },
        "filters": [
          {
            "profile": "default"
          },
          {
            "filter": "prod_finish_up_build_scripts"
          }
        ]
      }
    }
  }
}
