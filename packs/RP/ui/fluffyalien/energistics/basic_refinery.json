{
  "namespace": "fluffyalien_energistics:basic_refinery",
  "root@fluffyalien_energisticscore:common_v2.screen_template": {
    "$content_ref": "fluffyalien_energistics:basic_refinery.content"
  },
  "content@fluffyalien_energisticscore:common_v2.content_template": {
    "controls": [
      {
        "title@fluffyalien_energisticscore:common_v2.container_title": {
          "text": "tile.fluffyalien_energistics:basic_refinery.name"
        }
      },
      {
        "options_button@fluffyalien_energisticscore:common_v2.container_slot_nobg": {
          "offset": ["100%-24px", 12],
          "$index": 0
        }
      },
      {
        "energy_bar@fluffyalien_energisticscore:common_v2.machine_storage_bar": {
          "offset": [8, 12],
          "$start_index": 1
        }
      },
      {
        "input_plus1@fluffyalien_energistics:common.blue_plus_icon": {
          "offset": [28, 38]
        }
      },
      {
        "fluid_input@fluffyalien_energisticscore:common_v2.machine_storage_bar": {
          "offset": [44, 12],
          "$start_index": 5
        }
      },
      {
        "input_plus2@fluffyalien_energistics:common.blue_plus_icon": {
          "offset": [64, 38]
        }
      },
      {
        "input_slot@fluffyalien_energisticscore:common_v2.container_slot_item": {
          "offset": [80, 35],
          "$index": 9,
          "$background_images": "fluffyalien_energistics:common.blue_item_slot_image_panel"
        }
      },
      {
        // slots 11-12, centered in the gap between the inputs and the output
        "arrow_indicator@fluffyalien_energistics:common.icon_2x1": {
          "offset": [115, 38],
          "$start_index": 11
        }
      },
      {
        "output_slot@fluffyalien_energisticscore:common_v2.container_slot_item": {
          "offset": ["100%-26px", 35],
          "$index": 10,
          "$background_images": "fluffyalien_energistics:common.red_item_slot_image_panel"
        }
      }
    ]
  }
}
