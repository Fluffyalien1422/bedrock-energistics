{
  "namespace": "fluffyalien_energistics:coal_generator",
  "root@fluffyalien_energisticscore:common_v2.screen_template": {
    "$content_ref": "fluffyalien_energistics:coal_generator.content"
  },
  "content@fluffyalien_energisticscore:common_v2.content_template": {
    "controls": [
      {
        "title@fluffyalien_energisticscore:common_v2.container_title": {
          "text": "tile.fluffyalien_energistics:coal_generator.name"
        }
      },
      {
        "fuel_slot@fluffyalien_energisticscore:common_v2.container_slot_item": {
          "offset": [8, 35],
          "$index": 4,
          "$background_images": "fluffyalien_energistics:common.blue_item_slot_image_panel"
        }
      },
      {
        // slots 5-7, centered in the gap between the fuel slot and the energy bar
        "transfer_indicator@fluffyalien_energistics:common.transfer_indicator": {
          "offset": [80, "50%-8px"],
          "$start_index": 5
        }
      },
      {
        "energy_bar@fluffyalien_energisticscore:common_v2.machine_storage_bar": {
          "offset": ["100%-24px", 12]
        }
      }
    ]
  }
}
