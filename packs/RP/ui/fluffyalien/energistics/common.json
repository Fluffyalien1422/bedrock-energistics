{
  "namespace": "fluffyalien_energistics:common",

  // A tiled icon that is 2 tiles wide and 1 tall, such as the double arrow or the
  // long arrow. Occupies 2 slots: '$start_index' and '$start_index+1'.
  "icon_2x1": {
    "type": "panel",
    "$start_index|default": 0,
    "controls": [
      {
        "tile_0_0@fluffyalien_energisticscore:common_v2.container_slot_nobg_nohover": {
          "$index": "$start_index"
        }
      },
      {
        "tile_1_0@fluffyalien_energisticscore:common_v2.container_slot_nobg_nohover": {
          "offset": [16, 0],
          "$index": "($start_index+1)"
        }
      }
    ]
  },

  // Indicates whether the machine is working or not. Occupies 1 slot.
  "working_icon@fluffyalien_energisticscore:common_v2.container_slot_nobg_nohover": {},

  // A double arrow with a working icon below it, which indicates a transfer with no
  // specific progress value. Occupies 3 slots: '$start_index' and '$start_index+1'
  // are the arrow, '$start_index+2' is the working icon.
  "transfer_indicator": {
    "type": "panel",
    "$start_index|default": 0,
    "controls": [
      {
        "arrow@fluffyalien_energistics:common.icon_2x1": {}
      },
      {
        "working_icon@fluffyalien_energistics:common.working_icon": {
          "offset": [2, 16],
          "$index": "($start_index+2)"
        }
      }
    ]
  },

  // Goes between two inputs or two outputs to indicate that both are required.
  "plus_icon": {
    "type": "image",
    "texture": "$plus_icon_texture",
    "size": [12, 12],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  "blue_plus_icon@fluffyalien_energistics:common.plus_icon": {
    "$plus_icon_texture": "textures/fluffyalien/energistics/ui/blue_plus_icon"
  },

  "red_plus_icon@fluffyalien_energistics:common.plus_icon": {
    "$plus_icon_texture": "textures/fluffyalien/energistics/ui/red_plus_icon"
  },

  "custom_item_slot_image_panel": {
    "type": "panel",
    "$slot_image_ref|default": "common.cell_image",
    "controls": [
      {
        "cell_image@$slot_image_ref": {
          "$cell_selected_binding_name|default": "#is_selected_slot",
          "visible": true,
          "bindings": [
            {
              "binding_name": "(not $cell_selected_binding_name)",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ]
        }
      },
      {
        "cell_image_selected@common.cell_image_selected": {
          "$cell_selected_binding_name|default": "#is_selected_slot",
          "visible": false,
          "bindings": [
            {
              "binding_name": "$cell_selected_binding_name",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ]
        }
      }
    ]
  },

  "blue_item_slot_image": {
    "type": "image",
    "texture": "textures/fluffyalien/energistics/ui/blue_item_slot",
    "layer": 1
  },

  "blue_item_slot_image_panel@fluffyalien_energistics:common.custom_item_slot_image_panel": {
    "$slot_image_ref": "fluffyalien_energistics:common.blue_item_slot_image"
  },

  "red_item_slot_image": {
    "type": "image",
    "texture": "textures/fluffyalien/energistics/ui/red_item_slot",
    "layer": 1
  },

  "red_item_slot_image_panel@fluffyalien_energistics:common.custom_item_slot_image_panel": {
    "$slot_image_ref": "fluffyalien_energistics:common.red_item_slot_image"
  }
}
