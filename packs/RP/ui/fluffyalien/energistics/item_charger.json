{
  "namespace": "fluffyalien_energistics:item_charger",
  "root@fluffyalien_energisticscore:common_v2.screen_template": {
    "$content_ref": "fluffyalien_energistics:item_charger.content"
  },
  "content@fluffyalien_energisticscore:common_v2.content_template": {
    "controls": [
      {
        "title@fluffyalien_energisticscore:common_v2.container_title": {
          "text": "tile.fluffyalien_energistics:item_charger.name"
        }
      },
      {
        "energy_bar@fluffyalien_energisticscore:common_v2.machine_storage_bar": {
          "offset": [8, 12]
        }
      },
      {
        // slots 5-7, centered in the gap between the energy bar and the item slot
        "transfer_indicator@fluffyalien_energistics:common.transfer_indicator": {
          "offset": [78, "50%-8px"],
          "$start_index": 5
        }
      },
      {
        // the charged item is both the input and the output, so it keeps the
        // default slot rather than a blue or red one
        "item_slot@fluffyalien_energisticscore:common_v2.container_slot_item": {
          "offset": ["100%-26px", 35],
          "$index": 4
        }
      }
    ]
  }
}
