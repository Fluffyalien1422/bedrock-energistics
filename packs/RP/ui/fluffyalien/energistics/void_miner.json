{
  "namespace": "fluffyalien_energistics:void_miner",
  "root@fluffyalien_energisticscore:common_v2.screen_template": {
    "$content_ref": "fluffyalien_energistics:void_miner.content"
  },
  "content@fluffyalien_energisticscore:common_v2.content_template": {
    "controls": [
      {
        "title@fluffyalien_energisticscore:common_v2.container_title": {
          "text": "tile.fluffyalien_energistics:void_miner.name"
        }
      },
      {
        "energy_bar@fluffyalien_energisticscore:common_v2.machine_storage_bar": {
          "offset": [8, 12]
        }
      },
      {
        // slots 6-7, since the arrow's two tiles have to be next to each other
        "arrow_indicator@fluffyalien_energistics:common.icon_2x1": {
          "offset": ["50%-11px", 38],
          "$start_index": 6
        }
      },
      {
        "output_slot@fluffyalien_energisticscore:common_v2.container_slot_item": {
          "offset": ["100%-26px", 35],
          "$index": 5,
          "$background_images": "fluffyalien_energistics:common.red_item_slot_image_panel"
        }
      }
    ]
  }
}
